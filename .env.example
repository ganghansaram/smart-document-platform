# ── Smart Document Platform: Docker 환경 설정 ──
# 이 파일을 .env로 복사 후 환경에 맞게 수정

# 서비스 포트 (Nginx, 유일하게 외부 노출)
PORT=80

# 허용 Origin (쉼표 구분, 서버 IP에 맞게 설정)
# 예: CORS_ORIGINS=http://localhost,http://192.168.1.100
CORS_ORIGINS=http://localhost

# Ollama GPU 서버
OLLAMA_URL=http://gpu-server:11434
# OLLAMA_MODEL: 관리자 설정(Settings)에서 제어 (기본값: config.py)

# ── 임베딩 백엔드 (Plan-40: 용도별 분리) ──
# 해석 순서: 용도별 변수 > EMBEDDING_BACKEND(레거시 전역) > 코드 기본값
# 코드 기본값: INDEX=ollama (인덱싱 GPU 가속), RUNTIME=local (실시간 저지연)
#
# 환경별 권장 매트릭스:
#   회사 리눅스 VM (Ollama GPU 있음): INDEX=ollama, RUNTIME=local  ← 기본값 그대로
#   개발 PC (WSL, Ollama 네이티브): INDEX=ollama, RUNTIME=local    ← 기본값 그대로
#   회사 Windows PC (Ollama 없음): INDEX=local,  RUNTIME=local
#   폐쇄망 / Ollama 점검 중:        INDEX=local,  RUNTIME=local
#
# 레거시 단일 토글 (두 경로 동일하게 맞출 때만 사용, 신규 배포는 위 2개 변수 권장):
# EMBEDDING_BACKEND=local
#
# 용도별 지정 (주석 해제 시 해당 변수 우선):
# EMBEDDING_BACKEND_INDEX=ollama
# EMBEDDING_BACKEND_RUNTIME=local
#
# Ollama 청크 분할 크기 (0=분할 비활성). Phase 0 실측: 500까지 안정, 기본값 256 안전 마진.
# EMBEDDING_OLLAMA_BATCH=256

# 데이터 경로 (기본값 그대로 사용 가능)
DATA_DIR=./data
CONTENTS_DIR=./contents
MODELS_DIR=./models
BACKUPS_DIR=./backups

# 로그 경로 (기본값: ./logs)
# LOGS_DIR=./logs

# ── Smart Document Platform: Docker 환경 설정 ──
# 이 파일을 .env로 복사 후 환경에 맞게 수정

# 서비스 포트 (Nginx, 유일하게 외부 노출)
PORT=80

# Ollama GPU 서버
OLLAMA_URL=http://gpu-server:11434
# OLLAMA_MODEL: 관리자 설정(Settings)에서 제어 (기본값: config.py)

# 데이터 경로 (기본값 그대로 사용 가능)
DATA_DIR=./data
CONTENTS_DIR=./contents
MODELS_DIR=./models
BACKUPS_DIR=./backups

# 로그 경로 (기본값: ./logs)
# LOGS_DIR=./logs
